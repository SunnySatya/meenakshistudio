PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/meenakshi
JWT_SECRET=your_secret_key

# Cloudinary (free tier) — get these from https://cloudinary.com
# Dashboard → you'll see your Cloud Name, API Key, and API Secret
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Razorpay — get these from https://dashboard.razorpay.com
RAZORPAY_KEY_ID=your_key_id
RAZORPAY_KEY_SECRET=your_key_secret

# Meta WhatsApp Cloud API — https://developers.facebook.com/docs/whatsapp/cloud-api
# 1. Create a WhatsApp Business account + app at https://developers.facebook.com
# 2. Copy the permanent access token -> WHATSAPP_TOKEN
# 3. Copy the "Phone number ID" from the WhatsApp dashboard -> WHATSAPP_PHONE_NUMBER_ID
# 4. WHATSAPP_RECIPIENT = the WhatsApp number that should receive booking alerts (intl, no "+", e.g. 916398665027)
# 5. Create & approve a template named "booking_notification" in the Meta dashboard
#    Body example:
#    "New booking! Name: {{1}}, Email: {{2}}, Phone: {{3}}, Event: {{4}}, Date: {{5}}, Package: {{6}}, Location: {{7}}"
WHATSAPP_TOKEN=your_permanent_access_token
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_RECIPIENT=916398665027
WHATSAPP_TEMPLATE=booking_notification

# Email notifications — booking alerts via SMTP
# Gmail: enable 2-Step Verification, then create an App Password at google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
NOTIFY_EMAIL=your_email@gmail.com
